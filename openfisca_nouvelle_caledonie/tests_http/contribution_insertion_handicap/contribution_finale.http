### Variables globales
@baseUrl = http://localhost:5000

### ─────────────────────────────────────────────────────────────────────────────
### Cas 1 : Sans doublement, sans dépenses → finale = contribution
###   base=contribution=400032 ; depenses=0 ; finale=400032
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_sans_doublement_sans_depenses": {
      "beneficiaires_handicap": [],
      "contribution_avant_depenses_deductibles": { "2026": 400032.00 },
      "montant_doublement_contribution":          { "2026": 0 },
      "montant_depenses_deductibles":             { "2026": 0 },
      "montant_contribution":                     { "2026": null }
    }
  }
}

> {%
    client.test("Sans doublement, sans dépenses : finale = contribution = 400032", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_sans_doublement_sans_depenses"]
            .montant_contribution["2026"];
        client.assert(result === 400032, "Attendu 400032, recu " + result);
    });
%}

### ─────────────────────────────────────────────────────────────────────────────
### Cas 2 : Sans doublement, avec dépenses partielles
###   base=400032 ; depenses=100000 ; finale=floor(300032)=300032
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_sans_doublement_avec_depenses": {
      "beneficiaires_handicap": [],
      "contribution_avant_depenses_deductibles": { "2026": 400032.00 },
      "montant_doublement_contribution":          { "2026": 0 },
      "montant_depenses_deductibles":             { "2026": 100000 },
      "montant_contribution":                     { "2026": null }
    }
  }
}

> {%
    client.test("Sans doublement, dépenses partielles : finale = 300032", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_sans_doublement_avec_depenses"]
            .montant_contribution["2026"];
        client.assert(result === 300032, "Attendu 300032, recu " + result);
    });
%}

