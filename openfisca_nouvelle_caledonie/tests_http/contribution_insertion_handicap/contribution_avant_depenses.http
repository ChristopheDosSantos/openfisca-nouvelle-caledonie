### ─────────────────────────────────────────────────────────────────────────────
### Cas 5 : Aucun bénéficiaire manquant → contribution = 0
###   effectif=100 → nb_dus=2 ; unités_bénéf=1.9 + contrats=0.8 = 2.7 ≥ 2
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "entreprise_obligation_remplie": {
      "beneficiaires_handicap": [],
      "effectif_salarie":                          { "2026": 100 },
      "somme_unites_beneficiaires":                { "2026": 1.9 },
      "somme_unites_contrats_services":            { "2026": 0.8 },
      "somme_unites_contrats_disposition":         { "2026": 0 },
      "regime_smag":                               { "2026": false },
      "beneficiaires_manquants":                   { "2026": null },
      "contribution_avant_depenses_deductibles":   { "2026": null }
    }
  }
}

> {%
    client.test("Obligation remplie : contribution = 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");

        const manquants = response.body.entreprises["entreprise_obligation_remplie"]
            .beneficiaires_manquants["2026"];
        client.assert(manquants === 0, "Manquants attendus : 0, recu " + manquants);

        const contrib = response.body.entreprises["entreprise_obligation_remplie"]
            .contribution_avant_depenses_deductibles["2026"];
        client.assert(contrib === 0, "Contribution attendue : 0, recu " + contrib);
    });
%}

### ─────────────────────────────────────────────────────────────────────────────
### Cas 6 : Calcul intégré chaîne complète — obligation partiellement remplie
###   effectif=50 → nb_dus=1
###   unités bénéficiaires fournies = 0,5 (via input direct)
###   contrats = 0
###   manquants = floor((1 - 0,5) × 100) / 100 = 0,50
###   0,50 × 400 × 1 000,08 = 200 016,00
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "entreprise_partiel": {
      "beneficiaires_handicap": [],
      "effectif_salarie":                          { "2026": 50 },
      "somme_unites_beneficiaires":                { "2026": 0.5 },
      "somme_unites_contrats_services":            { "2026": 0 },
      "somme_unites_contrats_disposition":         { "2026": 0 },
      "regime_smag":                               { "2026": false },
      "beneficiaires_manquants":                   { "2026": null },
      "contribution_avant_depenses_deductibles":   { "2026": null }
    }
  }
}

> {%
    client.test("Obligation partiellement remplie : manquants=0.5, contribution=200016", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");

        const manquants = response.body.entreprises["entreprise_partiel"]
            .beneficiaires_manquants["2026"];
        client.assert(manquants === 0.5, "Manquants attendus : 0.5, recu " + manquants);

        const contrib = response.body.entreprises["entreprise_partiel"]
            .contribution_avant_depenses_deductibles["2026"];
        const expected = 200016.00;
        client.assert(contrib === expected, "Attendu " + expected + ", recu " + contrib);
    });
%}

