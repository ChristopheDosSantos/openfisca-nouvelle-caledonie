### Variables globales
@baseUrl = http://localhost:5000

### ─────────────────────────────────────────────────────────────────────────────
### Cas 1 : Entreprise exonérée (réponse création) → contribution = 0
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "entreprise_creation": {
      "beneficiaires_handicap": [],
      "effectif_salarie":                          { "2026": 50 },
      "somme_unites_beneficiaires":                { "2026": 0 },
      "somme_unites_contrats_services":            { "2026": 0 },
      "somme_unites_contrats_disposition":         { "2026": 0 },
      "regime_smag":                               { "2026": false },
      "exonere_contribution_insertion_handicap":   { "2026": true },
      "contribution_avant_depenses_deductibles":   { "2026": null }
    }
  }
}

> {%
    client.test("Entreprise en creation : contribution = 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["entreprise_creation"]
            .contribution_avant_depenses_deductibles["2026"];
        client.assert(result === 0, "Attendu 0, recu " + result);
    });
%}

### ─────────────────────────────────────────────────────────────────────────────
### Cas 2 : Effectif < 100, régime SMG, aucune unité
###   nb_beneficiaires = 1  (50 × 2,5 % = 1,25 → 1)
###   manquants        = 1
###   1 × 400 × 1 000,08 = 400 032,00
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "entreprise_sous_100_smg": {
      "beneficiaires_handicap": [],
      "effectif_salarie":                          { "2026": 50 },
      "somme_unites_beneficiaires":                { "2026": 0 },
      "somme_unites_contrats_services":            { "2026": 0 },
      "somme_unites_contrats_disposition":         { "2026": 0 },
      "regime_smag":                               { "2026": false },
      "contribution_avant_depenses_deductibles":   { "2026": null }
    }
  }
}

> {%
    client.test("Effectif < 100 SMG : multiplicateur 400, contribution = 400032", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["entreprise_sous_100_smg"]
            .contribution_avant_depenses_deductibles["2026"];
        const expected = 400032.00;
        client.assert(result === expected, "Attendu " + expected + ", recu " + result);
    });
%}

