### Variables globales
@baseUrl = http://localhost:5000

### Cas 1 : SERVICES -> unite_contrats_service active
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "contrat_services": {
      "type_contrat": {
        "2026": "services"
      },
      "prix_ht_fourniture": {
        "2026": 3000000
      },
      "cout_matiere_premiere": {
        "2026": 500000
      },
      "unite_contrats_service": {
        "2026": null
      },
      "unite_contrat_disposition": {
        "2026": null
      }
    }
  }
}

> {%
    client.test("SERVICES calcule 1.24 et DISPOSITION vaut 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");

        const service = response.body.individus["contrat_services"].unite_contrats_service["2026"];
        const disposition = response.body.individus["contrat_services"].unite_contrat_disposition["2026"];

        client.assert(service === 1.24, "Attendu service=1.24, recu " + service);
        client.assert(disposition === 0.0, "Attendu disposition=0.0, recu " + disposition);
    });
%}

### Cas 2 : DISPOSITION -> unite_contrat_disposition active
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "contrat_disposition": {
      "type_contrat": {
        "2026": "disposition"
      },
      "prix_ht_fourniture": {
        "2026": 2499999
      },
      "cout_matiere_premiere": {
        "2026": 0
      },
      "unite_contrats_service": {
        "2026": null
      },
      "unite_contrat_disposition": {
        "2026": null
      }
    }
  }
}

> {%
    client.test("DISPOSITION calcule 1.24 et SERVICES vaut 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");

        const service = response.body.individus["contrat_disposition"].unite_contrats_service["2026"];
        const disposition = response.body.individus["contrat_disposition"].unite_contrat_disposition["2026"];

        client.assert(service === 0.0, "Attendu service=0.0, recu " + service);
        client.assert(disposition === 1.24, "Attendu disposition=1.24, recu " + disposition);
    });
%}

### Cas 3 : Base nulle -> 0 unite
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "contrat_nul": {
      "type_contrat": {
        "2026": "services"
      },
      "prix_ht_fourniture": {
        "2026": 1200000
      },
      "cout_matiere_premiere": {
        "2026": 1200000
      },
      "unite_contrats_service": {
        "2026": null
      },
      "unite_contrat_disposition": {
        "2026": null
      }
    }
  }
}

> {%
    client.test("Base nulle donne 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");

        const service = response.body.individus["contrat_nul"].unite_contrats_service["2026"];
        const disposition = response.body.individus["contrat_nul"].unite_contrat_disposition["2026"];

        client.assert(service === 0.0, "Attendu service=0.0, recu " + service);
        client.assert(disposition === 0.0, "Attendu disposition=0.0, recu " + disposition);
    });
%}

