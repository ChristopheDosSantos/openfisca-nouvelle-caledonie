### Test 9.1 - contrat
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "individu_technique": {}
  },
  "contrats": {
    "contrat_services": {
      "signataires": [],
      "type_contrat": {
        "2026": "services"
      },
      "prix_ht_fourniture": {
        "2026": 120000
      },
      "cout_matiere_premiere": {
        "2026": 0
      },
      "unite_contrat": {
        "2026": null
      }
    }
  }
}
> {%
    client.test("Contrat services calcule 1.24 unite", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");

        const result = response.body.contrats["contrat_services"].unite_contrat["2026"];
        const expected = 0.05;
        client.assert(result === expected, "Attendu " + expected + ", recu " + result);
    });
%}

