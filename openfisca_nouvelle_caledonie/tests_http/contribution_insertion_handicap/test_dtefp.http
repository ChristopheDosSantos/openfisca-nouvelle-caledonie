### Variables globales
@baseUrl = http://localhost:5000

### Test 1
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "beneficiaire_1": {
      "qualite_beneficiaire": {
        "2026": "beneficiaire_a"
      },
      "nb_heures_travaillees": {
        "2026": 0
      },
      "unite_beneficiaire": {
        "2026": null
      }
    },
    "beneficiaire_2": {
      "qualite_beneficiaire": {
        "2026": "beneficiaire_a"
      },
      "nb_heures_travaillees": {
        "2026": 0
      },
      "unite_beneficiaire": {
        "2026": null
      }
    },
    "beneficiaire_3": {
      "qualite_beneficiaire": {
        "2026": "beneficiaire_a"
      },
      "nb_heures_travaillees": {
        "2026": 0
      },
      "unite_beneficiaire": {
        "2026": null
      }
    }
  },
  "entreprises": {
    "entreprise_1": {
      "beneficiaires_handicap": ["beneficiaire_1","beneficiaire_2","beneficiaire_3"],
      "effectif_salarie": {
        "2026": 313.77
      },
      "soumis_obligation_emploi_handicapes": {
        "2026": null
      },
      "nb_beneficiaires_devant_etre_employes": {
        "2026": null
      },
      "a_depenses_annee_en_cours":                { "2026": true },
      "a_employe_beneficiaires_annee_en_cours":   { "2026": true },
      "somme_depenses_ttc":                       { "2026": 4068670 },
      "eligible_doublement_cotisation":           { "2026": null },
      "montant_doublement_contribution":          { "2026": null },
      "contribution_avant_depenses_deductibles":  { "2026": null },
      "montant_depenses_deductibles":             { "2026": null },
      "montant_contribution":                     { "2026": null }
    }
  }
}
> {%
    client.test("contribution = 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const doublement = response.body.entreprises["entreprise_1"]
            .eligible_doublement_cotisation["2026"];
        client.assert(doublement === false, "Attendu false, recu " + doublement);
        const montant = response.body.entreprises["entreprise_1"]
            .montant_contribution["2026"];
        client.assert(montant === 0, "Attendu 0, recu " + montant);
    });
%}

