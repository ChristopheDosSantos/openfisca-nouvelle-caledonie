### Variables globales
@baseUrl = http://localhost:5000

### ─────────────────────────────────────────────────────────────────────────────
### Cas 1 : Pas de dépenses cette année → montant_depenses_deductibles = 0
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_pas_de_depenses": {
      "beneficiaires_handicap": [],
      "contribution_avant_depenses_deductibles": { "2026": 400032.00 },
      "montant_doublement_contribution":          { "2026": 0 },
      "a_depenses_annee_en_cours":                { "2026": false },
      "somme_depenses_ttc":                       { "2026": 100000.50 },
      "montant_depenses_deductibles":             { "2026": null }
    }
  }
}

> {%
    client.test("Pas de dépenses : montant_depenses_deductibles = 0", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_pas_de_depenses"]
            .montant_depenses_deductibles["2026"];
        client.assert(result === 0, "Attendu 0, recu " + result);
    });
%}

### ─────────────────────────────────────────────────────────────────────────────
### Cas 2 : Dépenses < contribution (sans doublement) → dépenses tronquées
###   somme=100000.75 → floor=100000 ; plafond=400032 ; min=100000
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_depenses_sous_plafond": {
      "beneficiaires_handicap": [],
      "contribution_avant_depenses_deductibles": { "2026": 400032.00 },
      "montant_doublement_contribution":          { "2026": 0 },
      "a_depenses_annee_en_cours":                { "2026": true },
      "somme_depenses_ttc":                       { "2026": 100000.75 },
      "montant_depenses_deductibles":             { "2026": null }
    }
  }
}

> {%
    client.test("Dépenses < contribution : deductible = floor(100000.75) = 100000", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_depenses_sous_plafond"]
            .montant_depenses_deductibles["2026"];
        client.assert(result === 100000, "Attendu 100000, recu " + result);
    });
%}

### ─────────────────────────────────────────────────────────────────────────────
### Cas 3 : Dépenses > contribution (sans doublement) → plafonnées à la contribution
###   somme=500000 ; plafond=contribution=400032 ; min=400032
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_depenses_sur_plafond": {
      "beneficiaires_handicap": [],
      "contribution_avant_depenses_deductibles": { "2026": 400032.00 },
      "montant_doublement_contribution":          { "2026": 0 },
      "a_depenses_annee_en_cours":                { "2026": true },
      "somme_depenses_ttc":                       { "2026": 500000 },
      "montant_depenses_deductibles":             { "2026": null }
    }
  }
}

> {%
    client.test("Dépenses > contribution : deductible = contribution = 400032", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_depenses_sur_plafond"]
            .montant_depenses_deductibles["2026"];
        client.assert(result === 400032, "Attendu 400032, recu " + result);
    });
%}

