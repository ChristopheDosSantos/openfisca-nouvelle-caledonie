### Variables globales
@baseUrl = http://localhost:5000

### ─────────────────────────────────────────────────────────────────────────────
### Cas 1 : Éligibilité bénéficiaires — aucun emploi jamais → éligible
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_elig_benef": {
      "beneficiaires_handicap": [],
      "a_employe_beneficiaires_annee_en_cours":    { "2026": false },
      "a_employe_beneficiaires_annees_precedentes":{ "2026": false },
      "eligible_doublement_cotisation_beneficiaire":{ "2026": null }
    }
  }
}

> {%
    client.test("Aucun emploi jamais : eligible_doublement_beneficiaire = true", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_elig_benef"]
            .eligible_doublement_cotisation_beneficiaire["2026"];
        client.assert(result === true, "Attendu true, recu " + result);
    });
%}

### ─────────────────────────────────────────────────────────────────────────────
### Cas 2 : Éligibilité bénéficiaires — emploi cette année → non éligible
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_non_elig_benef_cur": {
      "beneficiaires_handicap": [],
      "a_employe_beneficiaires_annee_en_cours":    { "2026": true },
      "a_employe_beneficiaires_annees_precedentes":{ "2026": false },
      "eligible_doublement_cotisation_beneficiaire":{ "2026": null }
    }
  }
}

> {%
    client.test("Emploi annee en cours : eligible_doublement_beneficiaire = false", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["e_non_elig_benef_cur"]
            .eligible_doublement_cotisation_beneficiaire["2026"];
        client.assert(result === false, "Attendu false, recu " + result);
    });
%}

