### ─────────────────────────────────────────────────────────────────────────────
### Cas 6 : Éligibilité globale — les deux conditions remplies → éligible
### ─────────────────────────────────────────────────────────────────────────────
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": { "individu_technique": {} },
  "entreprises": {
    "e_elig_global": {
      "beneficiaires_handicap": [],
      "a_employe_beneficiaires_annee_en_cours":    { "2026": false },
      "a_employe_beneficiaires_annees_precedentes":{ "2026": false },
      "a_contracte_annee_en_cours":                { "2026": false },
      "a_contracte_annees_precedentes":            { "2026": false },
      "eligible_doublement_cotisation_beneficiaire":{ "2026": null },
      "eligible_doublement_cotisation_contrat":    { "2026": null },
      "eligible_doublement_cotisation":            { "2026": null }
    }
  }
}

> {%
    client.test("Deux conditions remplies : eligible_doublement_cotisation = true", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const e = response.body.entreprises["e_elig_global"];
        client.assert(e.eligible_doublement_cotisation_beneficiaire["2026"] === true,
            "Eligible beneficiaire attendu true");
        client.assert(e.eligible_doublement_cotisation_contrat["2026"] === true,
            "Eligible contrat attendu true");
        client.assert(e.eligible_doublement_cotisation["2026"] === true,
            "Eligible global attendu true");
    });
%}

