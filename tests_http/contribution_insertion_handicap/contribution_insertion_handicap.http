    client.test("Entreprise de 39 salariés applique le minimum", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["entreprise_39"].soumis_obligation_emploi_handicapes["2026"];
        const expected = true;
