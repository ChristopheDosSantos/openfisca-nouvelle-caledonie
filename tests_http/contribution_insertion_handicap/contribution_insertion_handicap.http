        const nbResult = response.body.entreprises["entreprise_39"].nb_beneficiaires_devant_etre_employes["2026"];
        const nbExpected = 0.5;
        client.assert(nbResult === nbExpected, "Attendu " + nbExpected + ", reçu " + nbResult);
    });
%}

