### Variables globales
@baseUrl = http://localhost:5000

### Vérifier que l'API tourne
GET {{baseUrl}}/spec

### Cas 1: Entreprise de 25 salariés - doit être soumise
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "individu_1": {}
  },
  "entreprises": {
    "entreprise_25": {
      "salaries": ["individu_1"],
      "effectif_salarie": {
        "2026": 25
      },
      "soumis_obligation_emploi_handicapes": {
        "2026": null
      },
      "nb_beneficiaires_devant_etre_employes": {
        "2026": null
      }
    }
  }
}

> {%
    client.test("Entreprise de 25 salariés est soumise", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["entreprise_25"].soumis_obligation_emploi_handicapes["2026"];
        const expected = true;
        client.assert(result === expected, "Attendu " + expected + ", reçu " + result);

        const nbResult = response.body.entreprises["entreprise_25"].nb_beneficiaires_devant_etre_employes["2026"];
        const nbExpected = 0.5;
        client.assert(nbResult === nbExpected, "Attendu " + nbExpected + ", reçu " + nbResult);
    });
%}

### Cas 2: Entreprise de 20 salariés - ne doit PAS être soumise (strictement supérieur à 20)
POST {{baseUrl}}/calculate
Content-Type: application/json

{
  "individus": {
    "individu_2": {}
  },
  "entreprises": {
    "entreprise_20": {
      "salaries": ["individu_2"],
      "effectif_salarie": {
        "2026": 20
      },
      "soumis_obligation_emploi_handicapes": {
        "2026": null
      },
      "nb_beneficiaires_devant_etre_employes": {
        "2026": null
      }
    }
  }
}

> {%
    client.test("Entreprise de 20 salariés n'est pas soumise", function() {
        client.assert(response.status === 200, "Statut HTTP attendu : 200");
        const result = response.body.entreprises["entreprise_20"].soumis_obligation_emploi_handicapes["2026"];
        const expected = false;
        client.assert(result === expected, "Attendu " + expected + ", reçu " + result);

        const nbResult = response.body.entreprises["entreprise_20"].nb_beneficiaires_devant_etre_employes["2026"];
        const nbExpected = 0;
        client.assert(nbResult === nbExpected, "Attendu " + nbExpected + ", reçu " + nbResult);
    });
%}

